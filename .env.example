# Local development only. Production values are injected by the deploy
# pipeline (Cloud Run env vars / Secret Manager), never committed here.

APEX_ENV=dev
PORT=8080
LOG_LEVEL=debug

# Postgres. No custom CA is needed for most managed providers or a local
# instance — only set DATABASE_CA_BUNDLE_PATH for a host whose cert doesn't
# chain to a public root.
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex
DATABASE_CA_REQUIRED=false
# DATABASE_CA_BUNDLE_PATH=

# Evidence storage: GCS bucket + the Cloud KMS key used for CMEK on upload.
# Format: projects/{project}/locations/{location}/keyRings/{ring}/cryptoKeys/{key}
EVIDENCE_BUCKET=apex-dev-evidence
GCP_KMS_KEY_NAME=

# Sentinel's on-demand watch launcher (Cloud Run Jobs). Only needed in the
# lean profile, where Sentinel runs per-watch rather than as a standing
# service. Format: projects/{project}/locations/{location}/jobs/{job}
# SENTINEL_JOB_NAME=

# Identity Platform (Firebase Auth) verifies via Application Default
# Credentials — gcloud auth application-default login for local dev, or the
# Cloud Run service account in deployed environments. No config value here.

DASHBOARD_ORIGIN=*

# Ceilings any single Beast run may request. Operators cannot exceed these.
BEAST_MAX_BUDGET_USD=50
BEAST_MAX_DURATION_MINUTES=120
BEAST_MAX_CONCURRENT_TASKS=24

# Warden — comment classification and reply drafting via OpenRouter.
OPENROUTER_API_KEY=
# CLASSIFIER=keyword          # crude fallback instead of the model
# CLASSIFIER_MODEL=anthropic/claude-opus-5
# DRAFTER=off                 # classify only, never draft
# DRAFTER_MODEL=anthropic/claude-opus-5
# CHANNEL_VOICE=

# Warden — YouTube Data API OAuth client (see docs/youtube.md).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Dashboard (Vite, build-time). The web API key identifies the Identity
# Platform project; it is not a secret.
VITE_API_BASE=http://localhost:8080
VITE_FIREBASE_API_KEY=
